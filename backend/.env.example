# ============================================================
# Drone Video Platform - konfigurasi backend (opsional)
# Salin file ini menjadi backend\.env hanya jika ingin mengubah nilai bawaan.
# ============================================================

# --- Modul Drone Video Downloader ---
# Folder tujuan bawaan (bisa diganti setiap batch dari aplikasi).
# Kosong = %USERPROFILE%\Videos\Batch YouTube Downloader
DEFAULT_OUTPUT_DIR=

# Data downloader: riwayat batch & log (relatif terhadap folder platform). Bawaan: data\downloader
# DOWNLOADER_DATA_DIR=data/downloader

DEFAULT_QUALITY=1080
DEFAULT_PARALLEL=3
MAX_PARALLEL_DOWNLOADS=3
DOWNLOAD_RETRIES=3
# Isi jika ffmpeg tidak ada di PATH / tools\ffmpeg\bin, contoh: C:\ffmpeg\bin
FFMPEG_LOCATION=

# --- Modul Drone Video Trimmer ---
# Folder data Trimmer (database, unggahan, ekspor). Bawaan: data
# ADT_DATA_DIR=
# Port server (bawaan 8000)
# ADT_PORT=8000
